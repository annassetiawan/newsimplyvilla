generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Villa {
  id           String         @id @default(cuid())
  name         String
  address      String
  description  String?
  contact      String?
  facilities   String[]
  isOnboarded  Boolean        @default(false)
  updatedAt    DateTime       @updatedAt
  rooms        Room[]
  areas        Area[]
  staff        Staff[]
  tasks        Task[]
  inventory    InventoryItem[]
  sops         SOP[]
  transactions Transaction[]
  lostAndFound LostAndFound[]
  subscription Subscription?
  activityLogs ActivityLog[]
  businesses   Business[]
  pettyCash    PettyCash[]
  payrolls     Payroll[]
  budgets      Budget[]
  employees    Employee[]
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

model Room {
  id            String        @id @default(cuid())
  code          String
  name          String
  type          String
  capacity      Int
  pricePerNight Float
  status        RoomStatus    @default(AVAILABLE)
  photos        String[]
  villaId       String
  villa         Villa         @relation(fields: [villaId], references: [id])
  reservations  Reservation[]
}

model Area {
  id          String  @id @default(cuid())
  name        String
  description String?
  villaId     String
  villa       Villa   @relation(fields: [villaId], references: [id])
}

model Guest {
  id           String        @id @default(cuid())
  name         String
  idNumber     String?
  phone        String?
  email        String?
  notes        String?
  createdAt    DateTime      @default(now())
  reservations Reservation[]
}

enum ReservationStatus {
  CONFIRMED
  PENDING
  CHECKEDIN
  CHECKEDOUT
  CANCELLED
}

enum PaymentStatus {
  PAID
  UNPAID
}

model Reservation {
  id            String            @id @default(cuid())
  guestId       String
  roomId        String
  checkIn       DateTime
  checkOut      DateTime
  status        ReservationStatus @default(PENDING)
  paymentStatus PaymentStatus     @default(UNPAID)
  pricePerNight Float             @default(0)
  totalAmount   Float
  createdAt     DateTime          @default(now())
  guest         Guest             @relation(fields: [guestId], references: [id])
  room          Room              @relation(fields: [roomId], references: [id])
  transactions  Transaction[]

  @@index([roomId, status])
  @@index([checkOut, status])
  @@index([createdAt])
}

enum ItemCategory {
  LINEN
  AMENITY
  FNB
  MAINTENANCE
}

model InventoryItem {
  id        String          @id @default(cuid())
  sku       String
  name      String
  category  ItemCategory
  onHand    Int
  minLevel  Int
  unit      String
  villaId   String
  villa     Villa           @relation(fields: [villaId], references: [id])
  movements StockMovement[]
}

enum MovementType {
  IN
  OUT
}

model StockMovement {
  id       String        @id @default(cuid())
  itemId   String
  type     MovementType
  quantity Int
  date     DateTime      @default(now())
  note     String?
  item     InventoryItem @relation(fields: [itemId], references: [id])

  @@index([itemId, date])
}

enum TaskType {
  MAINTENANCE
  CLEANING
}

enum TaskPriority {
  HIGH
  MED
  LOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model Task {
  id         String       @id @default(cuid())
  title      String
  type       TaskType
  location   String
  priority   TaskPriority
  status     TaskStatus   @default(PENDING)
  assignedTo String?
  dueDate    DateTime?
  proofPhoto String?
  villaId    String
  villa      Villa        @relation(fields: [villaId], references: [id])

  @@index([villaId, status])
  @@index([villaId, type])
}

enum StaffRole {
  OWNER
  STAFF
}

model Staff {
  id             String    @id @default(cuid())
  supabaseUserId String?   @unique
  name           String
  role           StaffRole
  position       String
  email          String?   @unique
  isActive       Boolean   @default(true)
  permissions    String[]  @default([])
  villaId        String
  villa          Villa     @relation(fields: [villaId], references: [id])
  shifts         Shift[]
  payrolls       Payroll[]
  employee       Employee?
  createdAt      DateTime  @default(now())
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  OFF
}

model Shift {
  id        String    @id @default(cuid())
  staffId   String
  date      DateTime
  shiftType ShiftType
  staff     Staff     @relation(fields: [staffId], references: [id])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id            String          @id @default(cuid())
  date          DateTime
  type          TransactionType
  description   String
  amount        Float
  category      String
  paymentStatus PaymentStatus
  reservationId String?
  villaId       String
  villa         Villa           @relation(fields: [villaId], references: [id])
  reservation   Reservation?    @relation(fields: [reservationId], references: [id])

  @@index([villaId, date])
  @@index([villaId, type, date])
}

enum SOPCategory {
  FRONT_DESK
  HOUSEKEEPING
  MAINTENANCE
  INVENTORY
  SAFETY
}

model SOP {
  id               String      @id @default(cuid())
  title            String
  category         SOPCategory
  steps            Json
  estimatedMinutes Int
  villaId          String
  villa            Villa       @relation(fields: [villaId], references: [id])
  updatedAt        DateTime    @updatedAt
}

enum LostAndFoundStatus {
  FOUND
  CLAIMED
}

model LostAndFound {
  id          String             @id @default(cuid())
  item        String
  description String?
  location    String
  foundDate   DateTime
  status      LostAndFoundStatus @default(FOUND)
  villaId     String
  villa       Villa              @relation(fields: [villaId], references: [id])
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIAL
}

model Subscription {
  id        String             @id @default(cuid())
  villaId   String             @unique
  villa     Villa              @relation(fields: [villaId], references: [id])
  plan      Plan               @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  plan      Plan     @default(PRO)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  villaId   String
  villa     Villa    @relation(fields: [villaId], references: [id])
  staffName String?
  action    String
  module    String
  createdAt DateTime @default(now())

  @@index([villaId, createdAt])
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethod {
  CASH
  TRANSFER
}

model Business {
  id           String           @id @default(cuid())
  name         String
  type         String
  description  String?
  status       BusinessStatus   @default(ACTIVE)
  villaId      String
  villa        Villa            @relation(fields: [villaId], references: [id])
  items        BusinessItem[]
  transactions PosTransaction[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model BusinessItem {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  price      Float
  category   String
  photo      String?
  stock      Int      @default(0)
  villaId    String
}

model PosTransaction {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id])
  items         Json
  total         Float
  paymentMethod PaymentMethod
  note          String?
  villaId       String
  createdAt     DateTime      @default(now())

  @@index([businessId, createdAt])
  @@index([villaId, createdAt])
}

enum PettyCashType {
  IN
  OUT
}

model PettyCash {
  id          String        @id @default(cuid())
  date        DateTime      @default(now())
  description String
  type        PettyCashType
  amount      Float
  note        String?
  villaId     String
  villa       Villa         @relation(fields: [villaId], references: [id])
  createdAt   DateTime      @default(now())

  @@index([villaId, date])
}

enum PayrollStatus {
  PAID
  UNPAID
}

model Payroll {
  id         String        @id @default(cuid())
  staffId    String?
  staff      Staff?        @relation(fields: [staffId], references: [id])
  employeeId String?
  employee   Employee?     @relation(fields: [employeeId], references: [id])
  month      Int
  year       Int
  amount     Float
  status     PayrollStatus @default(UNPAID)
  paidAt     DateTime?
  note       String?
  villaId    String
  villa      Villa         @relation(fields: [villaId], references: [id])
  createdAt  DateTime      @default(now())

  @@unique([staffId, month, year])
  @@index([villaId, year, month])
}

model Budget {
  id      String @id @default(cuid())
  month   Int
  year    Int
  target  Float
  villaId String
  villa   Villa  @relation(fields: [villaId], references: [id])

  @@unique([villaId, month, year])
}

// --- Employee Management ---

enum Gender {
  MALE
  FEMALE
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  FREELANCE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  SICK
  LEAVE
  OFF
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Employee {
  id               String           @id @default(cuid())
  name             String
  photo            String?
  idNumber         String?
  birthPlace       String?
  birthDate        DateTime?
  gender           Gender?
  phone            String?
  address          String?
  position         String
  department       String?
  employmentType   EmploymentType   @default(PERMANENT)
  startDate        DateTime
  endDate          DateTime?
  baseSalary       Float?
  staffId          String?          @unique
  staff            Staff?           @relation(fields: [staffId], references: [id])
  status           EmployeeStatus   @default(ACTIVE)
  villaId          String
  villa            Villa            @relation(fields: [villaId], references: [id])
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  leaveAllocations LeaveAllocation[]
  payrolls         Payroll[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([villaId, status])
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  date       DateTime
  status     AttendanceStatus
  note       String?
  villaId    String

  @@unique([employeeId, date])
  @@index([villaId, date])
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])
  startDate  DateTime
  endDate    DateTime
  totalDays  Int
  reason     String
  status     LeaveStatus @default(PENDING)
  reviewedBy String?
  reviewNote String?
  villaId    String
  createdAt  DateTime    @default(now())

  @@index([villaId, status])
  @@index([employeeId, startDate])
}

model LeaveAllocation {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  year       Int
  totalDays  Int      @default(12)
  usedDays   Int      @default(0)
  villaId    String

  @@unique([employeeId, year])
}
